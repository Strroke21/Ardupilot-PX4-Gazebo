<?xml version="1.0"?>
<sdf version="1.10">

  <model name="zed2i">
    <static>false</static>

    <!-- ========================================================= -->
    <!-- BASE LINK                                                  -->
    <!-- ========================================================= -->

    <link name="zed_base_link">

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">

        <pose>0 0.03020 0.00262 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://zed2i/meshes/zed2i.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>

      </visual>

      <!-- ======================================================= -->
      <!-- IMU                                                       -->
      <!-- ======================================================= -->

      <sensor name="imu" type="imu">

        <always_on>true</always_on>
        <pose>0 0 0 0 0 -1.57</pose>

        <update_rate>200</update_rate>

        <topic>/zed2i/imu</topic>

      </sensor>

    </link>


    <!-- ========================================================= -->
    <!-- LEFT CAMERA LINK                                           -->
    <!-- ========================================================= -->

    <link name="zed2i_left_camera_link">

      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>0.001</mass>

        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


      <!-- ======================================================= -->
      <!-- LEFT CAMERA                                               -->
      <!-- ======================================================= -->

      <sensor name="zed2i_left_camera"
              type="camera">

        <pose>0 0 -0.12 0 0 -1.57</pose>

        <always_on>true</always_on>

        <visualize>true</visualize>

        <update_rate>60</update_rate>

        <topic>/zed2i/left/image_raw</topic>

        <camera>

          <!-- 110 degrees -->
          <horizontal_fov>1.25664</horizontal_fov>
          <vertical_fov>0.767945</vertical_fov>

          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          
        </camera>

      </sensor>

    </link>


    <!-- ========================================================= -->
    <!-- RIGHT CAMERA LINK                                          -->
    <!-- ========================================================= -->

    <link name="zed2i_right_camera_link">

      <!-- 120 mm stereo baseline -->
      <pose>-0.12 0.12 0 0 0 0</pose>

      <inertial>
        <mass>0.001</mass>

        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


      <!-- ======================================================= -->
      <!-- RIGHT CAMERA                                              -->
      <!-- ======================================================= -->

      <sensor name="zed2i_right_camera"
              type="camera">

        <pose>0 0 -0.12 0 0 -1.57</pose>

        <always_on>true</always_on>

        <visualize>true</visualize>

        <update_rate>60</update_rate>

        <topic>/zed2i/right/image_raw</topic>

        <camera>

          <horizontal_fov>1.25664</horizontal_fov>
          <vertical_fov>0.767945</vertical_fov>

          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>

        </camera>

      </sensor>

    </link>


    <!-- ========================================================= -->
    <!-- CAMERA MOUNTING JOINTS                                     -->
    <!-- ========================================================= -->

    <joint name="zed2i_left_camera_joint"
           type="fixed">

      <parent>zed_base_link</parent>
      <child>zed2i_left_camera_link</child>

    </joint>


    <joint name="zed2i_right_camera_joint"
           type="fixed">

      <parent>zed_base_link</parent>
      <child>zed2i_right_camera_link</child>

    </joint>


    <!-- ========================================================= -->
    <!-- LEFT OPTICAL FRAME                                         -->
    <!-- ========================================================= -->

    <frame name="zed2i_left_camera_optical_frame"
           attached_to="zed2i_left_camera_link">
      <pose>0 0 0 0 0 0</pose>

    </frame>


    <!-- ========================================================= -->
    <!-- RIGHT OPTICAL FRAME                                        -->
    <!-- ========================================================= -->

    <frame name="zed2i_right_camera_optical_frame"
           attached_to="zed2i_right_camera_link">
      <pose>0 0 0 0 0 0</pose>
    </frame>


  </model>

</sdf>
